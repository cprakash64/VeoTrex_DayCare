# Non-secret deployment variables for the staging control plane.
#
# Copy to a root-owned file on the deployment host (NOT into this repository) and pass it to
# compose with --env-file. Every value here is non-secret; actual secrets live in the files
# referenced by VEOTREX_STAGING_SECRETS_DIR and in the two root-owned env files below.
#
# There is deliberately no default hostname. No hostname is invented by this repository.

# Fully qualified staging hostname, approved by the operator. DNS A/AAAA (or CNAME) must
# already point at this host before the proxy can obtain a certificate.
VEOTREX_STAGING_HOST=

# Contact address used for ACME certificate issuance and expiry notices.
VEOTREX_ACME_EMAIL=

# Application version reported by the health endpoints.
VEOTREX_APP_VERSION=0.1.0-staging

# Ring Client ID is an identifier, not a secret. It stays "replace-with-ring-client-id" until
# the Ring private app exists.
VEOTREX_RING_CLIENT_ID=replace-with-ring-client-id

# Root-owned directory (0700) holding the secret files (each 0600), outside the repository:
#   postgres_password        - staging database password, newly generated
#   vault_master_key         - 32-byte AEAD master key, independent of every other secret
#   ring_client_secret       - empty until the Ring portal gate
#   ring_hmac_signing_key    - empty until the Ring portal gate
VEOTREX_STAGING_SECRETS_DIR=/etc/veotrex/staging/secrets

# Root-owned 0600 env file holding VEOTREX_DATABASE_URL, which is read directly as a setting
# and has no file-reference support.
VEOTREX_STAGING_API_ENV=/etc/veotrex/staging/api.env

# Root-owned 0600 env file holding the Auth0 server-side values the Next.js SDK reads from
# the process environment: AUTH0_DOMAIN, AUTH0_CLIENT_ID, AUTH0_CLIENT_SECRET, AUTH0_SECRET,
# AUTH0_AUDIENCE.
VEOTREX_STAGING_WEB_ENV=/etc/veotrex/staging/web.env
