# Staging control-plane API image. CPU-only: no CUDA, TensorRT, GStreamer, models or camera
# stack ever belongs here - that is the private Jetson edge, not the public control plane.
#
# Build context is the repository root (the workspace lockfile lives there).

FROM python:3.12-slim-bookworm AS builder

# uv is copied from its own published image so the version is pinned and reproducible.
COPY --from=ghcr.io/astral-sh/uv:0.9.6 /uv /usr/local/bin/uv

# The environment is built at the path it will be USED from. uv writes absolute shebangs into
# every console script (alembic, uvicorn, veotrex-ring-readiness), so building at /build/.venv and
# copying to /app/.venv leaves each script pointing at an interpreter that the runtime stage does
# not contain: the scripts exist but exec fails with ENOENT on /build/.venv/bin/python.
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT=/app/.venv

WORKDIR /build

# Dependency layer first: it changes far less often than application source.
COPY pyproject.toml uv.lock ./
COPY apps/api/pyproject.toml apps/api/
COPY services/edge-agent/pyproject.toml services/edge-agent/

# --package selects only the control-plane member, so the image does not carry the
# edge-agent's NumPy/SciPy/Pillow closure. The "never use --package" rule from earlier stages
# is about `uv run --package` mutating the SHARED developer virtualenv on the Jetson; inside a
# throwaway build container there is no shared environment to damage, and narrowing is the goal.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-install-project --package veotrex-api

COPY apps/api/ apps/api/
COPY services/edge-agent/pyproject.toml services/edge-agent/

# --no-editable installs the project into site-packages. An editable install writes the
# BUILDER's absolute source path into _editable_impl_veotrex_api.pth, which does not exist
# in the runtime stage, so `import veotrex_api` fails everywhere except under alembic -
# alembic.ini sets prepend_sys_path and silently masked the broken install.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-editable --package veotrex-api


FROM python:3.12-slim-bookworm AS runtime

# Non-root runtime. The application never needs to write to its own image.
RUN groupadd --system --gid 10001 veotrex \
 && useradd --system --uid 10001 --gid veotrex --home /app --shell /usr/sbin/nologin veotrex \
 && install -d -m 0700 -o veotrex -g veotrex /var/lib/veotrex/staff-media

WORKDIR /app

COPY --from=builder --chown=root:root /app/.venv /app/.venv
COPY --from=builder --chown=root:root /build/apps/api /app/apps/api

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

USER veotrex
EXPOSE 8000

# Readiness touches the database, so it is used for the healthcheck but is deliberately NOT
# published through the reverse proxy - Ring does not need it and it reveals dependency state.
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=5 \
    CMD ["python", "-c", "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/health/ready', timeout=4).status == 200 else 1)"]

# No --reload. Exactly ONE worker: the edge WHEP broker keeps its Ring session leases in process
# memory (V1-DEMO-03B, ADR 0021), so a second worker would receive DELETEs for leases it never
# issued. Do not raise this without first moving leases to a shared store. proxy_headers are
# accepted only because the only client is the trusted in-network reverse proxy (see Caddyfile).
CMD ["uvicorn", "veotrex_api.main:app", \
     "--host", "0.0.0.0", "--port", "8000", \
     "--workers", "1", \
     "--proxy-headers", "--forwarded-allow-ips", "*", \
     "--no-server-header", \
     "--timeout-keep-alive", "20"]
