# Non-secret deployment variables for the Hostinger VPS staging control plane.
#
# Copy to a root-owned file on the host (NOT into this repository) and pass it to compose with
# --env-file. Every value here is non-secret; the actual secrets are files under
# VEOTREX_HOSTINGER_SECRETS_DIR and in the root-owned web env file below.

# Canonical public origin. Ring callback URLs are derived from this value server-side and never
# from a Host or X-Forwarded-Host header.
VEOTREX_PUBLIC_ORIGIN=https://daycare.veotrex.com

# OIDC bearer-token verification for the API. The issuer is the Auth0 tenant (trailing slash
# required); the audience is the Auth0 API identifier. Neither is secret. Both are mandatory:
# their defaults point at *.example.invalid, which would accept no token from the real tenant.
VEOTREX_OIDC_ISSUER=https://REPLACE_WITH_AUTH0_TENANT/
VEOTREX_OIDC_AUDIENCE=https://daycare.veotrex.com/api

# Application version reported by the health endpoints.
VEOTREX_APP_VERSION=0.1.0-staging

# Ring Client ID is an identifier, not a secret. It stays as the placeholder until the Ring
# private app exists.
VEOTREX_RING_CLIENT_ID=replace-with-ring-client-id

# Optional egress proxy for Ring API (control-plane) requests only - never Ring OAuth token
# exchange, never Auth0. Leave unset (or empty) for direct egress, which is the default and
# the behaviour before this variable existed. Set it only on a host where the direct path to
# the Ring API is rejected, e.g.:
#   VEOTREX_RING_API_PROXY_URL=socks5://<docker-bridge-gateway>:<port>
VEOTREX_RING_API_PROXY_URL=

# Root-owned directory (0700) holding the secret files (each 0600), outside the repository:
#   database_url           - full DSN, so the URL never enters the process environment
#   postgres_password      - matches the password embedded in database_url
#   vault_master_key       - 32-byte AEAD key, independent of every other secret
#   ring_client_secret     - empty until the Ring portal gate
#   ring_hmac_signing_key  - empty until the Ring portal gate
VEOTREX_HOSTINGER_SECRETS_DIR=/etc/veotrex-daycare/secrets

# Root-owned 0600 env file holding the Auth0 values the Next.js SDK reads from the process
# environment: AUTH0_DOMAIN, AUTH0_CLIENT_ID, AUTH0_CLIENT_SECRET, AUTH0_SECRET, AUTH0_AUDIENCE.
VEOTREX_HOSTINGER_WEB_ENV=/etc/veotrex-daycare/web.env
