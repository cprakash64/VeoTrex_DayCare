# /etc/veotrex-edge/edge.env - non-secret configuration of the VeoTrex edge agent service.
# Installed once by `veotrex-edge-ctl.sh install` (root:veotrex-edge, 0640) and never
# overwritten by it. Every key is read as VEOTREX_EDGE_<FIELD> by veotrex_edge_agent.config.
#
# No secret belongs in this file. The edge agent holds no credential today; a future one is
# delivered through systemd LoadCredential=, not through this environment.

# Stable identity of this edge node. The installer generates a random UUID here when the
# file is created; replace it only through a deliberate device-enrollment procedure.
VEOTREX_EDGE_NODE_ID=00000000-0000-0000-0000-000000000000
VEOTREX_EDGE_ENVIRONMENT=production
VEOTREX_EDGE_LOG_LEVEL=INFO
# GPU worker health-check cadence (5-300 s). Also the recovery latency after a worker crash.
VEOTREX_EDGE_HEARTBEAT_INTERVAL_SECONDS=30

# Brokered Ring WHEP (V1-DEMO-03B, ADR 0021). Disabled while both are empty. The node never
# holds a Ring token: it presents its own machine credential to the control plane's broker.
# The URL must be a bare public HTTPS origin. The credential file holds the value issued once
# by `veotrex-edge-credential issue` on the control plane; it must be a regular file owned by
# the service user with mode 0600 or 0400 (for example a systemd LoadCredential= path). Only
# its location belongs here - never the credential itself.
#VEOTREX_EDGE_CONTROL_PLANE_URL=https://control-plane.example.com
#VEOTREX_EDGE_CREDENTIAL_FILE=/run/credentials/veotrex-edge.service/edge-node-credential
