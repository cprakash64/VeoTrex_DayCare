# Copy to .env for local development. Values below are non-production local defaults.
VEOTREX_ENVIRONMENT=local
VEOTREX_LOG_LEVEL=INFO
VEOTREX_DATABASE_URL=postgresql+psycopg://veotrex:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:5432/veotrex
VEOTREX_APP_VERSION=0.1.0
VEOTREX_OIDC_ISSUER=https://your-auth0-domain.example/
VEOTREX_OIDC_AUDIENCE=https://api.veotrex.example
VEOTREX_OIDC_ALLOWED_ALGORITHMS=RS256
VEOTREX_OIDC_JWKS_CACHE_TTL_SECONDS=300
VEOTREX_OIDC_JWKS_FORCED_REFRESH_COOLDOWN_SECONDS=10
VEOTREX_OIDC_HTTP_TIMEOUT_SECONDS=5
VEOTREX_OIDC_CLOCK_SKEW_SECONDS=30

# Alternative to VEOTREX_DATABASE_URL: a secret reference resolved through SecretResolver, so a
# deployment can mount the DSN as a file instead of exposing it in the process environment.
# Configure exactly one of the two - setting both is refused.
# VEOTREX_DATABASE_URL_REF=file:/run/secrets/database_url

# Development PostgreSQL (persistent, loopback-only) and the separate disposable test cluster.
# Passwords are supplied to the containers through infra/local/secrets/* and are never committed;
# the values below are placeholders you replace locally.
VEOTREX_POSTGRES_PORT=5432
VEOTREX_TEST_POSTGRES_PORT=55433

# Destructive database tests use ONLY this target and never VEOTREX_DATABASE_URL. It must name a
# database ending in _test on a PostgreSQL cluster distinct from development, because roles are
# cluster-wide.
VEOTREX_TEST_DATABASE_URL=postgresql+psycopg://veotrex_test:REPLACE_WITH_LOCAL_TEST_PASSWORD@127.0.0.1:55433/veotrex_test

# Ring identifiers and secret references only. Resolve referenced secrets outside this file.
VEOTREX_RING_OAUTH_TOKEN_URL=https://oauth.ring.com/oauth/token
VEOTREX_RING_API_BASE_URL=https://api.amazonvision.com
VEOTREX_RING_CLIENT_ID=replace-with-ring-client-id
VEOTREX_RING_CLIENT_SECRET_REF=env:RING_CLIENT_SECRET
VEOTREX_RING_HMAC_SIGNING_KEY_REF=env:RING_HMAC_SIGNING_KEY
VEOTREX_RING_INVENTORY_RETRY_ATTEMPTS=3
VEOTREX_RING_INVENTORY_MAX_PAGES=10
VEOTREX_RING_INVENTORY_MAX_DEVICES=500
VEOTREX_RING_INVENTORY_MAX_COMPONENT_READS=2000
VEOTREX_RING_INVENTORY_BACKOFF_MAX_SECONDS=10
VEOTREX_RING_WEBHOOK_BODY_BYTES=65536
VEOTREX_RING_CONNECT_TIMEOUT_SECONDS=3
VEOTREX_RING_READ_TIMEOUT_SECONDS=10
VEOTREX_RING_WRITE_TIMEOUT_SECONDS=5
VEOTREX_RING_NONCE_VALIDATION_WINDOW_SECONDS=600
VEOTREX_RING_NONCE_FUTURE_TOLERANCE_SECONDS=0
VEOTREX_RING_ACCESS_TOKEN_REFRESH_MARGIN_SECONDS=300
VEOTREX_RING_PENDING_CANDIDATE_MAX_AGE_SECONDS=3600
VEOTREX_RING_MAX_ACCESS_TOKEN_LIFETIME_SECONDS=604800
VEOTREX_RING_MAX_RESPONSE_BYTES=65536
VEOTREX_RING_TOKEN_EXCHANGE_BODY_BYTES=1024
VEOTREX_RING_TOKEN_EXCHANGE_RATE_LIMIT_PER_MINUTE=30

# Public HTTPS origin of the control plane. Ring callback URLs are derived from this value and
# never from an incoming Host/X-Forwarded-Host header. Leave empty until a real deployed hostname
# exists; readiness then reports it as missing rather than guessing one.
# Example shape only (not a real deployment): https://control.example.test
VEOTREX_PUBLIC_ORIGIN=

# Reference to the credential-vault AEAD master key, resolved through SecretResolver. This is a
# REFERENCE, never the key itself: supply the 32-byte key to the process environment or secret
# file named here. Never commit a key, put one in a migration, or pass one as a CLI argument.
VEOTREX_VAULT_MASTER_KEY_REF=env:VEOTREX_VAULT_MASTER_KEY

# Auth0 Next.js SDK v4 server-only settings. Use secret-manager values in production.
AUTH0_DOMAIN=https://your-auth0-domain.example
AUTH0_CLIENT_ID=replace-with-auth0-client-id
AUTH0_CLIENT_SECRET=replace-with-auth0-client-secret
AUTH0_SECRET=replace-with-64-hex-character-session-secret
APP_BASE_URL=http://localhost:3000
AUTH0_AUDIENCE=https://api.veotrex.example
VEOTREX_API_BASE_URL=http://localhost:8000
VEOTREX_EDGE_NODE_ID=00000000-0000-0000-0000-000000000001
VEOTREX_EDGE_HEARTBEAT_INTERVAL_SECONDS=30
