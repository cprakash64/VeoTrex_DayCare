# Copy to .env for local development. Values below are non-production local defaults.
VEOTREX_ENVIRONMENT=local
VEOTREX_LOG_LEVEL=INFO
VEOTREX_DATABASE_URL=postgresql+psycopg://veotrex:veotrex_local_only@localhost:5432/veotrex
VEOTREX_APP_VERSION=0.1.0
VEOTREX_OIDC_ISSUER=https://your-auth0-domain.example/
VEOTREX_OIDC_AUDIENCE=https://api.veotrex.example
VEOTREX_OIDC_ALLOWED_ALGORITHMS=RS256
VEOTREX_OIDC_JWKS_CACHE_TTL_SECONDS=300
VEOTREX_OIDC_JWKS_FORCED_REFRESH_COOLDOWN_SECONDS=10
VEOTREX_OIDC_HTTP_TIMEOUT_SECONDS=5
VEOTREX_OIDC_CLOCK_SKEW_SECONDS=30

# Auth0 Next.js SDK v4 server-only settings. Use secret-manager values in production.
AUTH0_DOMAIN=https://your-auth0-domain.example
AUTH0_CLIENT_ID=replace-with-auth0-client-id
AUTH0_CLIENT_SECRET=replace-with-auth0-client-secret
AUTH0_SECRET=replace-with-64-hex-character-session-secret
APP_BASE_URL=http://localhost:3000
AUTH0_AUDIENCE=https://api.veotrex.example
VEOTREX_API_BASE_URL=http://localhost:8000
VEOTREX_EDGE_NODE_ID=00000000-0000-0000-0000-000000000001
VEOTREX_EDGE_HEARTBEAT_INTERVAL_SECONDS=30
