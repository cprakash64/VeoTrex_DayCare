# Copy to .env for local development. Values below are non-production local defaults.
VEOTREX_ENVIRONMENT=local
VEOTREX_LOG_LEVEL=INFO
VEOTREX_DATABASE_URL=postgresql+psycopg://veotrex:veotrex_local_only@localhost:5432/veotrex
VEOTREX_APP_VERSION=0.1.0
VEOTREX_EDGE_NODE_ID=00000000-0000-0000-0000-000000000001
VEOTREX_EDGE_HEARTBEAT_INTERVAL_SECONDS=30
