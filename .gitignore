.DS_Store
._*
.env*
!.env.example
!**/.env.example
credentials/
# Local PostgreSQL secret files read by compose through POSTGRES_PASSWORD_FILE. These are
# created by the operator on the host and must never be committed.
infra/local/secrets/
*.pem
*.key
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
node_modules/
.pnpm-store/
.next/
*.tsbuildinfo
coverage/
reports/qualification/
*.log
*.db
*.sqlite
*.sqlite3
*.engine
*.plan
*.trt
recordings/
temporary-clips/
artifacts/models/candidates/
artifacts/validation/
dist/
*.egg-info/

# Locally supplied demonstration footage. Recordings of real children must never be
# committed; keep them on the machine that plays them. See docs/demo/daycare-owner-demo.md.
data/demo/*
!data/demo/.gitkeep
!data/demo/README.md

# Ultralytics model weights for the macOS demo. Downloaded on first run, never committed:
# the production detector is a TensorRT engine, not a .pt file.
*.pt
